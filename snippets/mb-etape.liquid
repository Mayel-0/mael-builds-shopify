{% doc %}
  Une étape de montage, repliable. À rendre avec « for » : le snippet
  utilise forloop pour numéroter l'étape et ouvrir la première.

  @param {metaobject} etape - Le métaobjet Étape (titre, contenu, image)
  @param {boolean} [ouvert] - Ouvre la première étape par défaut

  @example
  {% render 'mb-etape' for etapes as etape, ouvert: true %}
{% enddoc %}

{%- # theme-check-disable UndefinedObject -%}
{%- # forloop existe bien ici : il est fourni par « render … for » (Theme Check ne le sait pas) -%}
{% assign current_index = forloop.index %}

{% if etape != blank %}
  <li class="mb-etape">
    <details
      {% if ouvert and forloop.first %}
        open
      {% endif %}
    >
      <summary>
        <h4 class="mb-etape__titre">
          <span>
            {%- if current_index < 10 -%}
              0{{ current_index }}
            {%- else -%}
              {{ current_index }}
            {%- endif -%}
          </span>
          {{ etape.titre.value }}
        </h4>
      </summary>

      <div class="mb-etape__contenu">
        {% if etape.image.value != blank %}
          <div class="mb-etape__conteneur-image">
            {{
              etape.image.value
              | image_url: width: 400, height: 400
              | image_tag: alt: etape.titre.value, loading: 'lazy', class: 'mb-etape__image'
            }}
          </div>
        {% endif %}
        {{ etape.contenu | metafield_tag }}
      </div>
    </details>
  </li>
{%- endif %}
