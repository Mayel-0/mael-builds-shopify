{% doc %}
  Affiche un matériau sous forme de pastille colorée.

  @param {metaobject} materiau - Le métaobjet Matériau à afficher
  @param {boolean} [avec_temperature] - Affiche aussi la température de buse

  @example
  {% render 'badge-materiau', materiau: piece.materiau.value, avec_temperature: true %}
{% enddoc %}

{%- if materiau != blank -%}
  <span class="badge-materiau" style="--couleur-materiau: {{ materiau.couleur.value }};">
    <span class="badge-materiau__pastille"></span>
    {{ materiau.nom.value }}
    · {{ materiau.temperature_buse.value }} °C
  </span>
{%- endif -%}
