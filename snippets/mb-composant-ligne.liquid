{% doc %}
  @param {metaobject} ligne - La ligne du composant (métachamp produit custom.lignes)
  @param {metaobject} composant - Le composant du produit (métachamp produit custom.composants)

  @example
  {% render 'mb-composant-ligne', ligne: ligne, composant: composant %}
{% enddoc %}

{% if ligne and composant != blank %}
  <div class="mb-composant-ligne">
    <div class="mb-composant-ligne__contenu">
      <div class="mb-composant-ligne__image">
        {%- if composant.image.value != blank -%}
          {{
            composant.image.value
            | image_url: width: 400, height: 400, crop: 'center'
            | image_tag: alt: composant.nom.value, loading: 'lazy', class: 'mb-composant-ligne__img'
          }}
        {%- endif -%}
      </div>

      <p class="mb-composant-ligne__texte">
        <span class="mb-composant-ligne__quantite">{{ ligne.quantite.value }}</span>
        <span class="mb-composant-ligne__fois">×</span>
        <span class="mb-composant-ligne__nom">{{ composant.nom.value }}</span>
      </p>
    </div>
    {%- if composant.lien.value != blank -%}
      <div class="mb-composant-ligne__lien">
        {%- comment -%} Site externe : nouvel onglet, sans donner accès à notre page (noopener) {%- endcomment -%}
        <a href="{{ composant.lien.value }}" target="_blank" rel="noopener noreferrer">
          {{- 'mael.composants.acheter' | t -}}
          <span class="visually-hidden"> {{ composant.nom.value }} ({{ 'accessibility.new_window' | t }})</span>
        </a>
      </div>
    {%- endif -%}
  </div>
{% endif %}
