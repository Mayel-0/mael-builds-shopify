{% doc %}
  Affiche une pièce imprimée : nom, infos (quantité, temps, couche) et badge du matériau.
  UNE seule structure HTML : la mise en page (compacte / détaillée) est gérée en CSS
  par le bloc parent (mb-liste-pieces), le contenu par les paramètres ci-dessous.

  @param {metaobject} piece - Le métaobjet Pièce
  @param {metaobject} materiel - Le métaobjet Matériau de la pièce
  @param {boolean} [afficher_temps] - Affiche le temps d'impression de la pièce
  @param {boolean} [afficher_couche] - Affiche la hauteur de couche (champ hauteur_couche)
  @param {boolean} [afficher_temperature] - Affiche la température de buse dans le badge
  @param {string} [format_temps] - 'decimal' (8,3 h) ou 'heures' (8h18)

  @example
  {% render 'mb-piece', piece: piece, materiel: piece.materiau.value, afficher_temps: true %}
{% enddoc %}

{%- liquid
  assign quantite = piece.quantite.value | default: 1
  assign heures_decimales = piece.temps_impression.value | times: quantite
  assign couche = piece.hauteur_couche.value
  assign separateur = 'mael.duree.separateur' | t
  assign hauteur_couche = couche | append: '' | replace: '.', separateur
-%}

{%- if piece != blank -%}
  <div class="mb-piece" style="--couleur-materiau: {{ materiel.couleur.value | default: 'transparent' }};">
    <div class="mb-piece__infos">
      <span class="mb-piece__nom">{{ piece.nom.value }}</span>
      {%- comment -%} Chaque info est un <span> : les « · » entre eux sont ajoutés en CSS {%- endcomment -%}
      <span class="mb-piece__meta">
        <span>{{ 'mael.pieces.quantite' | t: count: quantite }}</span>
        {%- if afficher_temps -%}
          <span>{%- render 'mb-duree', heures_decimales: heures_decimales, format: format_temps -%}</span>
        {%- endif -%}
        {%- if afficher_couche and couche != blank -%}
          <span>{{ 'mael.pieces.couche' | t: hauteur: hauteur_couche }}</span>
        {%- endif -%}
      </span>
    </div>

    {%- if materiel != blank -%}
      <span class="mb-piece__badge">
        {{- materiel.nom.value -}}
        {%- if afficher_temperature and materiel.temperature_buse.value != blank %} · {{ materiel.temperature_buse.value }} °C{% endif -%}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
