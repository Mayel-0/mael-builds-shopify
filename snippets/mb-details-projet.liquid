{% doc %}
  Affiche le résumé chiffré d'un projet : temps d'impression, matériau, pièces, composants, niveau.

  @param {metaobject} pieces - Liste des pièces
  @param {metaobject} composants - Liste des composants
  @param {string} difficulte - Niveau de difficulté du projet

  @example
  {% render 'mb-details-projet', pieces: projet.pieces.value, composants: projet.composant.value, difficulte: projet.difficulte.value %}
{% enddoc %}

{%- liquid
  assign total_quantite = 0
  assign total_temps_impression = 0
  assign total_composant = 0

  for piece in pieces
    assign quantite = piece.quantite.value | default: 1
    assign total_quantite = total_quantite | plus: quantite
    assign temps_impression = piece.temps_impression.value | times: quantite
    assign total_temps_impression = total_temps_impression | plus: temps_impression
    assign materiel = piece.materiau.value.nom.value
  endfor

  for composant in composants
    assign quantite = composant.quantite.value
    assign total_composant = total_composant | plus: quantite
  endfor
-%}

<div class="mb-details-projet">
  <div>
    <span class="mb-details-projet__label">{{ 'mael.projet.temps_impression' | t }}</span>
    <p class="mb-details-projet__valeur">
      {%- render 'mb-duree', heures_decimales: total_temps_impression, format: 'heures' -%}
    </p>
  </div>
  <div>
    <span class="mb-details-projet__label">{{ 'mael.projet.materiau' | t }}</span>
    <p class="mb-details-projet__valeur">{{ materiel }}</p>
  </div>
  <div>
    <span class="mb-details-projet__label">{{ 'mael.projet.pieces' | t }}</span>
    <p class="mb-details-projet__valeur">{{ total_quantite }}</p>
  </div>
  <div>
    <span class="mb-details-projet__label">{{ 'mael.projet.composants' | t }}</span>
    <p class="mb-details-projet__valeur">{{ total_composant }}</p>
  </div>
  <div>
    <span class="mb-details-projet__label">{{ 'mael.projet.niveau' | t }}</span>
    <p class="mb-details-projet__valeur">{{ difficulte }}</p>
  </div>
</div>
