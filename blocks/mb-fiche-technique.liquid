{%- assign projet = closest.product.metafields.custom.projet.value -%}
{%- assign pieces = projet.pieces.value -%}

{%- capture contenu_fiche -%}

  {%- for piece in pieces -%}
    {%- render 'mb-materiel', materiel: piece.materiau.value, piece: piece -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if contenu_fiche != blank -%}
  <div {{ block.shopify_attributes }}>
    {% render 'mb-details-produit',
      titre: block.settings.titre_summary,
      contenu: contenu_fiche,
      ouvert: block.settings.ouvert
    %}
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>Aucune pièce associée à ce produit.</p>
{%- endif -%}

{% schema %}
{
  "name": "Fiche technique",
  "presets": [
    {
      "name": "Fiche technique"
    }
  ],
  "settings": [
    { "type": "text", "id": "titre_summary", "label": "Titre du Button", "default": "Fiche technique" },
    { "type": "checkbox", "id": "ouvert", "label": "Ouvert par défaut", "default": true }
  ]
}
{% endschema %}
