{%- liquid
  # Le projet vient du parent, dans cet ordre :
  # 1. le projet du produit transmis (fiche produit, Groupe produit, Hero en mode produit)
  # 2. le projet transmis directement (Hero en mode projet)
  # 3. le projet de la page en cours (page projet)
  assign projet = blank
  if closest.product != blank
    assign projet = closest.product.metafields.custom.projet.value
  elsif closest.metaobject.projet != blank
    assign projet = closest.metaobject.projet
  elsif metaobject.system.type == 'projet'
    assign projet = metaobject
  endif
  assign etapes = projet.etape.value
-%}

{% if etapes != blank %}
  <div
    class="mb-etapes"
    {{ block.shopify_attributes }}
    {% if block.settings.bordure_boolean %}
      style="--bordure-etape: {{ block.settings.couleur_bordure }}; --bordure-taille: {{ block.settings.bordure_epaisseur }}px; --bordure-radius: {{ block.settings.bordure_radius }}px;"
    {% endif %}
  >
    <ol class="mb-etapes__liste">
      {% render 'mb-etape' for etapes as etape, ouvert: block.settings.ouvert, niveau: block.settings.niveau %}
    </ol>
  </div>
{% elsif request.design_mode %}
  <p {{ block.shopify_attributes }}>{{ 'mael.editeur.aucune_etape' | t }}</p>
{%- endif %}

{% schema %}
{
  "name": "t:mael.etapes.name",
  "tag": null,
  "presets": [
    {
      "name": "t:mael.etapes.name"
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "ouvert", "label": "t:mael.etapes.ouvert", "default": true },
    {
      "type": "select",
      "id": "niveau",
      "label": "t:mael.titre.niveau",
      "info": "t:mael.defauts.niveau_info",
      "default": "h3",
      "options": [
        { "label": "t:mael.titre.h2", "value": "h2" },
        { "label": "t:mael.titre.h3", "value": "h3" },
        { "label": "t:mael.titre.h4", "value": "h4" }
      ]
    },
    { "type": "checkbox", "id": "bordure_boolean", "label": "t:mael.etapes.bordure", "default": false },
    {
      "type": "color",
      "id": "couleur_bordure",
      "label": "t:settings.border_color",
      "default": "{{ settings.color_palette.color1 }}",
      "visible_if": "{{ block.settings.bordure_boolean }}"
    },
    {
      "type": "range",
      "id": "bordure_epaisseur",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 10,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ block.settings.bordure_boolean }}"
    },
    {
      "type": "range",
      "id": "bordure_radius",
      "label": "t:settings.corner_radius",
      "unit": "px",
      "min": 0,
      "max": 50,
      "default": 0,
      "visible_if": "{{ block.settings.bordure_boolean }}"
    }
  ]
}
{% endschema %}
