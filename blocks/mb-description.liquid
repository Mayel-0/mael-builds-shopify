{%- liquid
  # Ce que le parent transmet, dans cet ordre :
  # 1. un produit (fiche produit, carte, Groupe produit, Hero…)
  # 2. un projet (Hero avec un projet choisi…)
  # 3. le projet de la page en cours (page projet)
  assign context = blank
  if closest.product != blank
    assign context = 'produit'
  elsif closest.metaobject.projet != blank
    assign context = 'projet'
    assign projet = closest.metaobject.projet
  elsif metaobject.system.type == 'projet'
    assign context = 'projet'
    assign projet = metaobject
  endif
-%}

{%- if context != blank -%}
  {%- if context == 'produit' -%}
    <div {{ block.shopify_attributes }}>
      {% render 'mb-details',
        titre: block.settings.titre_summary,
        contenu: closest.product.description,
        ouvert: block.settings.ouvert,
        bordure: block.settings.afficher_bordure
      %}
    </div>
  {% endif %}
  {%- if context == 'projet' -%}
    <div {{ block.shopify_attributes }}>
      <p>{{ projet.accroche.value }}</p>
      {% render 'mb-resume-projet',
        pieces: projet.pieces.value,
        composants: projet.composant.value,
        difficulte: projet.difficulte.value
      %}
    </div>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>{{ 'mael.editeur.description' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:mael.description.name",
  "tag": null,
  "presets": [
    {
      "name": "t:mael.description.name"
    }
  ],
  "settings": [
    { "type": "text", "id": "titre_summary", "label": "t:mael.description.titre", "default": "Description" },
    { "type": "checkbox", "id": "ouvert", "label": "t:settings.open_by_default", "default": true },
    { "type": "checkbox", "id": "afficher_bordure", "label": "t:mael.commun.bordure_bas", "default": true }
  ]
}
{% endschema %}
