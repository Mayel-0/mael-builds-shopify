{%- liquid
  # Le projet vient du parent, dans cet ordre :
  # 1. le projet du produit transmis (fiche produit, Groupe produit, Hero en mode produit)
  # 2. le projet transmis directement (Hero en mode projet)
  # 3. le projet de la page en cours (page projet)
  assign projet = blank
  if closest.product != blank
    assign projet = closest.product.metafields.custom.projet.value
  elsif closest.metaobject.projet != blank
    assign projet = closest.metaobject.projet
  elsif metaobject.system.type == 'projet'
    assign projet = metaobject
  endif
  assign pieces = projet.pieces.value
  assign total_temps_impression = 0
-%}

{%- comment -%}
  1. La boucle D'ABORD : elle capture le HTML de chaque pièce
     ET additionne les temps (les assign dans un capture modifient bien la variable).
     Les réglages de CONTENU sont transmis au snippet.
{%- endcomment -%}
{%- capture detail_pieces -%}
  {%- for piece in pieces -%}
    {%- liquid
      assign quantite = piece.quantite.value | default: 1
      assign temps_piece = piece.temps_impression.value | times: quantite
      assign total_temps_impression = total_temps_impression | plus: temps_piece
    -%}
    {%- render 'mb-piece',
      piece: piece,
      materiel: piece.materiau.value,
      afficher_temps: block.settings.afficher_temps_piece,
      afficher_couche: block.settings.afficher_couche,
      afficher_temperature: block.settings.afficher_temperature,
      format_temps: block.settings.format_temps
    -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if detail_pieces != blank -%}
  {%- comment -%} Réglage de MISE EN PAGE → une classe (--compacte / --detaillee) sur le conteneur {%- endcomment -%}
  <div
    class="mb-liste-pieces {{ block.settings.disposition }}{% if block.settings.afficher_separateurs %} mb-liste-pieces--separateurs{% endif %}"
    {{ block.shopify_attributes }}
  >
    {%- comment -%} 2. Le résumé ENSUITE : le total est connu. Affiché en premier, calculé en dernier. {%- endcomment -%}
    {%- if block.settings.afficher_resume -%}
      <div class="mb-liste-pieces__resume">
        <span class="mb-liste-pieces__resume-texte">{{ block.settings.texte_resume }}</span>
        <span class="mb-liste-pieces__total">
          {%- render 'mb-duree', heures_decimales: total_temps_impression, format: block.settings.format_temps -%}
        </span>
      </div>
    {%- endif -%}

    {{ detail_pieces }}
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>{{ 'mael.editeur.aucune_piece' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:mael.liste_pieces.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "disposition",
      "label": "t:settings.layout",
      "default": "mb-liste-pieces--detaillee",
      "options": [
        { "label": "t:mael.liste_pieces.detaillee", "value": "mb-liste-pieces--detaillee" },
        { "label": "t:mael.liste_pieces.compacte", "value": "mb-liste-pieces--compacte" }
      ]
    },
    { "type": "checkbox", "id": "afficher_separateurs", "label": "t:mael.liste_pieces.separateurs", "default": true },
    { "type": "header", "content": "t:mael.liste_pieces.header_total" },
    { "type": "checkbox", "id": "afficher_resume", "label": "t:mael.liste_pieces.afficher_total", "default": true },
    {
      "type": "text",
      "id": "texte_resume",
      "label": "t:mael.liste_pieces.texte_total",
      "default": "t:mael.defauts.temps_total",
      "visible_if": "{{ block.settings.afficher_resume }}"
    },
    {
      "type": "select",
      "id": "format_temps",
      "label": "t:mael.liste_pieces.format_temps",
      "default": "decimal",
      "options": [
        { "label": "t:mael.liste_pieces.format_decimal", "value": "decimal" },
        { "label": "t:mael.liste_pieces.format_heures", "value": "heures" }
      ]
    },
    { "type": "header", "content": "t:mael.liste_pieces.header_pieces" },
    { "type": "checkbox", "id": "afficher_temps_piece", "label": "t:mael.liste_pieces.temps_piece", "default": true },
    {
      "type": "checkbox",
      "id": "afficher_couche",
      "label": "t:mael.liste_pieces.couche",
      "info": "t:mael.liste_pieces.couche_info",
      "default": true
    },
    { "type": "checkbox", "id": "afficher_temperature", "label": "t:mael.liste_pieces.temperature", "default": true }
  ],
  "presets": [{ "name": "t:mael.liste_pieces.name" }]
}
{% endschema %}
