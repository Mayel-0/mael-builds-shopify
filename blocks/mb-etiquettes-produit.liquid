{%- assign projet = closest.product.metafields.custom.projet.value -%}
{%- if projet == blank and metaobject.system.type == 'projet' -%}
  {%- assign projet = metaobject -%}
{%- endif -%}

{%- if product and projet != blank -%}
  <div
    class="mb-etiquettes-produit"
    {{ block.shopify_attributes }}
    style="--mb-graisse-type: {{ block.settings.style_type }};"
  >
    <span class="mb-etiquettes-produit__type">
      {%- if block.settings.upcase_type == true %}{{ product.type | upcase }}{% else %}{{ product.type }}{% endif -%}
    </span>
    {% render 'mb-badge-difficulte', difficulte: projet.difficulte.value, prefixe: block.settings.prefixe_difficulte %}
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>Ajoute un type de produit ou une difficulté dans l'admin.</p>
{%- endif -%}

{% schema %}
{
  "name": "Etiquettes produit",
  "presets": [
    {
      "name": "Etiquettes produit"
    }
  ],
  "settings": [
    { "type": "text", "id": "prefixe_difficulte", "label": "Préfixe difficulté", "default": "Niveau" },
    { "type": "checkbox", "id": "upcase_type", "label": "Mettre le type de produit en majuscules", "default": true },
    {
      "type": "select",
      "id": "style_type",
      "label": "Choisir le style du texte pour le type du produit",
      "default": "300",
      "options": [
        { "label": "Light", "value": "300" },
        { "label": "Normal", "value": "400" },
        { "label": "Gras", "value": "600" }
      ]
    }
  ]
}
{% endschema %}
