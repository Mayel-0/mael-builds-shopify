{%- liquid
  assign titre = blank
  assign label = blank
  assign contexte = blank

  if closest.product != blank
    assign titre = closest.product.title
    assign contexte = 'produit'
  elsif metaobject.system.type == 'projet'
    assign titre = metaobject.titre.value
    assign label = 'Making-of'
    assign type = metaobject.produit.value.type
    assign contexte = 'projet'
  endif
-%}

{%- if titre != blank -%}
  <div {{ block.shopify_attributes }} class="mb-titre-produit mb-titre-produit--{{ contexte }}">
    {%- if label != blank -%}
      <p class="mb-titre-produit__label">
        {{ label }} ·
        {{ type | upcase }}
      </p>
    {%- endif -%}
    <h1 class="mb-titre-produit__titre">
      {{ titre }}
    </h1>
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>Ce bloc affiche le titre d'un produit ou d'un projet.</p>
{%- endif -%}

{% schema %}
{
  "name": "Titre",
  "presets": [
    {
      "name": "Titre"
    }
  ],
  "settings": []
}
{% endschema %}
