{%- liquid
  # Destination : le réglage « Lien » d'abord (utilisable partout : accueil, hero…).
  # Vide → lien automatique entre produit et projet, comme avant.
  assign url = block.settings.lien

  if url != blank
    assign texte_petit_lien_defaut = 'mael.liens.voir_plus' | t
  elsif closest.product != blank
    # Page produit → page du projet
    assign url = closest.product.metafields.custom.projet.value.system.url
    assign texte_petit_lien_defaut = 'mael.liens.voir_projet' | t
  elsif metaobject.system.type == 'projet'
    # Page projet → produit à acheter
    assign url = metaobject.produit.value.url
    assign texte_petit_lien_defaut = 'mael.liens.voir_produit' | t
  endif

  assign texte_petit_lien = block.settings.texte_petit_lien | default: texte_petit_lien_defaut

  if block.settings.petit_lien != true
    assign balise = 'a'
  else
    assign balise = 'div'
  endif
-%}

{%- if url != blank -%}
  <{{ balise }}
    {% if balise == 'a' %}
      href="{{ url }}"
    {% endif %}
    class="mb-lien {{ block.settings.style }} {{ block.settings.position_label }}"
    style="
      --font-align: {{ block.settings.font_align }};
      --lien-padding-x: {{ block.settings.padding_horizontal }}px;
      --lien-padding-y: {{ block.settings.padding_vertical }}px;
      --largeur-lien: {{ block.settings.largeur_lien }}%;
      --decoration-lien: {% if block.settings.souligner %}underline{% else %}none{% endif %};
      {% if block.settings.couleur_texte != blank %}--couleur-texte-lien: {{ block.settings.couleur_texte }};{% endif %}
      --decoration-petit-lien: {% if block.settings.souligner_petit_lien %}underline{% else %}none{% endif %};
      {% if block.settings.couleur_petit_lien != blank %}--couleur-petit-lien: {{ block.settings.couleur_petit_lien }};{% endif %}
    "
    {{ block.shopify_attributes }}
  >
    <span class="mb-lien__textes">
      {%- if block.settings.label_boolean and block.settings.texte_label != blank -%}
        <span class="mb-lien__label">{{ block.settings.texte_label }}</span>
      {%- endif -%}
      <span class="mb-lien__lien">{{ block.settings.texte_lien }}</span>
    </span>
    {%- if block.settings.petit_lien == false and block.settings.arrow_boolean == true -%}
      <span class="mb-lien__fleche svg-wrapper" aria-hidden="true">
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </span>
    {%- endif -%}
    {%- if block.settings.petit_lien == true -%}
      <a class="mb-lien__petit-lien" href="{{ url }}">{{ texte_petit_lien }}</a>
    {%- endif -%}
  </{{ balise }}>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>{{ 'mael.editeur.aucun_lien' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:mael.lien.name",
  "tag": null,
  "presets": [
    {
      "name": "t:mael.lien.name"
    }
  ],
  "settings": [
    {
      "type": "url",
      "id": "lien",
      "label": "t:settings.link",
      "info": "t:mael.lien.lien_info"
    },
    { "type": "header", "content": "t:content.text" },
    { "type": "checkbox", "id": "label_boolean", "label": "t:mael.lien.afficher_label", "default": true },
    {
      "type": "text",
      "id": "texte_label",
      "label": "t:mael.lien.texte_label",
      "default": "t:mael.defauts.lien_label",
      "visible_if": "{{ block.settings.label_boolean }}"
    },
    {
      "type": "select",
      "id": "position_label",
      "label": "t:mael.lien.position_label",
      "default": "mb-lien--label-dessus",
      "options": [
        { "label": "t:mael.lien.label_dessus", "value": "mb-lien--label-dessus" },
        { "label": "t:mael.lien.label_dessous", "value": "mb-lien--label-dessous" }
      ],
      "visible_if": "{{ block.settings.label_boolean }}"
    },
    { "type": "text", "id": "texte_lien", "label": "t:mael.lien.texte_lien", "default": "t:mael.defauts.lien_texte" },
    { "type": "checkbox", "id": "souligner", "label": "t:mael.lien.souligner", "default": false },
    { "type": "header", "content": "t:content.appearance" },
    {
      "type": "select",
      "id": "style",
      "label": "t:mael.lien.style",
      "default": "mb-lien--clair",
      "options": [
        { "label": "t:mael.lien.style_clair", "value": "mb-lien--clair" },
        { "label": "t:mael.lien.style_sombre", "value": "mb-lien--sombre" },
        { "label": "t:mael.lien.style_transparent", "value": "mb-lien--transparent" }
      ]
    },
  
    {
      "type": "color",
      "id": "couleur_texte",
      "label": "t:settings.text_color",
      "info": "t:mael.lien.couleur_texte_info",
      "visible_if": "{{ block.settings.style == 'mb-lien--transparent' }}"
    },
    {
      "type": "select",
      "id": "font_align",
      "label": "t:settings.alignment",
      "default": "left",
      "options": [
        { "label": "t:options.left", "value": "left" },
        { "label": "t:options.center", "value": "center" },
        { "label": "t:options.right", "value": "right" }
      ]
    },
    { "type": "checkbox", "id": "petit_lien", "label": "t:mael.lien.petit_lien", "default": false },
    {
      "type": "text",
      "id": "texte_petit_lien",
      "label": "t:mael.lien.texte_petit_lien",
      "info": "t:mael.lien.texte_petit_lien_info",
      "visible_if": "{{ block.settings.petit_lien }}"
    },
    {
      "type": "checkbox",
      "id": "souligner_petit_lien",
      "label": "t:mael.lien.souligner_petit_lien",
      "default": false,
      "visible_if": "{{ block.settings.petit_lien }}"
    },
    {
      "type": "color",
      "id": "couleur_petit_lien",
      "label": "t:mael.lien.couleur_petit_lien",
      "info": "t:mael.lien.couleur_petit_lien_info",
      "visible_if": "{{ block.settings.petit_lien and block.settings.style == 'mb-lien--transparent' }}"
    },
    {
      "type": "checkbox",
      "id": "arrow_boolean",
      "label": "t:mael.lien.fleche",
      "default": true,
      "visible_if": "{{ block.settings.petit_lien != true }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "t:mael.commun.padding_horizontal",
      "max": 50,
      "min": 0,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "t:mael.commun.padding_vertical",
      "max": 60,
      "min": 0,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "largeur_lien",
      "label": "t:settings.width",
      "max": 100,
      "min": 0,
      "default": 100,
      "unit": "%"
    }
  ]
}
{% endschema %}
