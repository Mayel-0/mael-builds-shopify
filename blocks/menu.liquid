{% liquid
  assign block_settings = block.settings
  assign menu = block_settings.menu
  assign heading = block_settings.heading
  assign show_as_accordion = block_settings.show_as_accordion

  # Case « Afficher le titre » décochée : on réutilise la classe --empty de Horizon,
  # qui masque le titre (sauf en accordéon sur mobile, où il sert à ouvrir le menu).
  assign titre_masque = false
  if block_settings.afficher_titre == false
    assign titre_masque = true
  endif
  if heading == blank and menu.title == blank
    assign titre_masque = true
  endif
  if show_as_accordion == true and block_settings.accordion_dividers == true
    assign dividers_enabled = true
  endif
%}

{% if menu != blank or heading != blank %}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    section_id: block.id
  %}
  {%- liquid
    assign menu_class = 'menu'
    if show_as_accordion == true
      assign menu_class = menu_class | append: ' menu--accordion'
    endif
    if dividers_enabled == true
      assign menu_class = menu_class | append: ' menu--dividers'
    endif
    assign should_disable_on_mobile = false
    assign should_open_by_default_on_mobile = false
    if show_as_accordion == false
      assign should_disable_on_mobile = true
      assign should_open_by_default_on_mobile = true
    endif
  -%}
  {% capture menu_accordion_children %}
    <details
      class="
        menu__details
        spacing-style
        {% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}
      "
      data-testid="menu-details"
      style="
        --spacing--size: {{ block_settings.menu_spacing }}px;
        {% render 'spacing-style', settings: block_settings %}
      "
      {% if show_as_accordion == false %}
        open
      {% endif %}
      {{ block.shopify_attributes }}
    >
      <summary class="menu__heading{% if titre_masque %} menu__heading--empty{% endif %} {{ block_settings.heading_preset }}">
        <span class="menu__heading__default">{{ heading | default: menu.title }}</span>
        <span class="menu__heading__accordion">
          {{ heading | default: menu.title }}
          {% if block_settings.accordion_icon == 'plus' %}
            <span class="menu__heading__toggle svg-wrapper icon-plus">
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </span>
          {% else %}
            <span class="menu__heading__toggle svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          {% endif %}
        </span>
      </summary>

      <nav
        class="details-content"
        {% if heading == blank or titre_masque %}
          aria-label="{{ menu.title | escape }}"
        {% endif %}
      >
        {% if menu %}
          <ul
            class="list-unstyled menu__liste {{ block_settings.direction }}"
            style="
              --lien-padding-y: {{ block_settings.lien_padding_vertical }}px;
              --lien-padding-x: {{ block_settings.lien_padding_horizontal }}px;
              --lien-bordure: {{ block_settings.lien_bordure_epaisseur }}px;
              --lien-arrondi: {{ block_settings.lien_bordure_arrondi }}px;
              {% if block_settings.lien_bordure_couleur != blank %}--lien-bordure-couleur: {{ block_settings.lien_bordure_couleur }};{% endif %}
              --lien-actif-fond: {{ block_settings.lien_actif_fond }};
              --lien-actif-texte: {{ block_settings.lien_actif_texte }};
            "
          >
            {% for link in menu.links %}
              <li class="menu__item {{ block_settings.link_preset }}">
                {%- comment -%} link.current : le lien pointe vers la page affichée {%- endcomment -%}
                <a
                  href="{{ link.url }}"
                  {% if link.current and block_settings.lien_actif %}
                    class="menu__lien--actif" aria-current="page"
                  {% endif %}
                >
                  {{ link.title }}{% if link.data_sharing_opt_out_icon %}{{ link.data_sharing_opt_out_icon }}{% endif %}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>
    </details>
  {% endcapture %}
  {% render 'accordion-custom-component',
    children: menu_accordion_children,
    class: menu_class,
    disable_on_desktop: true,
    open_by_default_on_desktop: true,
    disable_on_mobile: should_disable_on_mobile,
    open_by_default_on_mobile: should_open_by_default_on_mobile
  %}
{% endif %}

{% stylesheet %}
  .menu {
    width: 100%;
  }

  .menu:not(:has(.menu__heading--empty)) .details-content {
    margin-block-start: var(--spacing--size);
  }

  .menu__item + .menu__item {
    margin-block-start: var(--spacing--size);
  }

  /* Bordure et padding de chaque lien (réglages « Liens ») */
  .menu__liste a {
    display: inline-block;
    padding: var(--lien-padding-y, 0) var(--lien-padding-x, 0);
    border: var(--lien-bordure, 0) solid var(--lien-bordure-couleur, currentColor);
    border-radius: var(--lien-arrondi, 0);
  }

  /* Lien de la page en cours (réglages « Lien actif ») */
  .menu__liste .menu__lien--actif {
    background: var(--lien-actif-fond);
    border-color: var(--lien-actif-fond);
    color: var(--lien-actif-texte);
  }

  /* Liens côte à côte : l'espace vertical sert d'espace entre les liens */
  .menu__liste--horizontale {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing--size);
  }

  .menu__liste--horizontale .menu__item + .menu__item {
    margin-block-start: 0;
  }

  .menu .menu__heading--empty {
    display: none;
  }

  .menu__heading__default {
    display: contents;
  }

  .menu__heading__accordion {
    display: none;
  }

  @media screen and (max-width: 749px) {
    /* Always show the fallback heading on mobile when accordion is enabled */
    .menu--accordion .menu__heading--empty {
      display: flex;
    }

    .menu--accordion .menu__heading__accordion {
      display: contents;
    }

    .menu--accordion .menu__heading__default {
      display: none;
    }

    .menu--accordion .details-content {
      margin-block-start: var(--spacing--size);
    }

    .menu--accordion .menu__details {
      padding-inline: 0;
    }

    .menu--dividers .menu__details {
      border-block-end: var(--style-border-width) solid var(--color-border);
    }

    .menu--dividers .details-content {
      padding-block-end: var(--padding-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "checkbox",
      "id": "afficher_titre",
      "label": "t:mael.menu.afficher_titre",
      "info": "t:mael.menu.afficher_titre_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:mael.menu.direction",
      "default": "menu__liste--verticale",
      "options": [
        { "value": "menu__liste--verticale", "label": "t:options.vertical" },
        { "value": "menu__liste--horizontale", "label": "t:options.horizontal" }
      ]
    },
    {
      "type": "range",
      "id": "menu_spacing",
      "label": "t:mael.menu.espace_liens",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    { "type": "header", "content": "t:mael.menu.header_liens" },
    { "type": "range", "id": "lien_padding_vertical", "label": "t:mael.commun.padding_vertical", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "lien_padding_horizontal", "label": "t:mael.commun.padding_horizontal", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "lien_bordure_epaisseur", "label": "t:settings.border_width", "min": 0, "max": 5, "step": 1, "unit": "px", "default": 0 },
    {
      "type": "color",
      "id": "lien_bordure_couleur",
      "label": "t:settings.border_color",
      "info": "t:mael.menu.bordure_couleur_info",
      "visible_if": "{{ block.settings.lien_bordure_epaisseur > 0 }}"
    },
    { "type": "range", "id": "lien_bordure_arrondi", "label": "t:settings.corner_radius", "min": 0, "max": 50, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "t:mael.menu.header_actif" },
    { "type": "checkbox", "id": "lien_actif", "label": "t:mael.menu.lien_actif", "default": false },
    { "type": "color", "id": "lien_actif_fond", "label": "t:settings.background_color", "default": "#000000", "visible_if": "{{ block.settings.lien_actif }}" },
    { "type": "color", "id": "lien_actif_texte", "label": "t:settings.text_color", "default": "#ffffff", "visible_if": "{{ block.settings.lien_actif }}" },
    {
      "type": "checkbox",
      "id": "show_as_accordion",
      "label": "t:settings.show_as_accordion",
      "default": false
    },
    {
      "type": "select",
      "id": "accordion_icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "caret",
          "label": "t:options.caret"
        },
        {
          "value": "plus",
          "label": "t:options.plus"
        }
      ],
      "default": "caret",
      "visible_if": "{{ block.settings.show_as_accordion == true }}"
    },
    {
      "type": "checkbox",
      "id": "accordion_dividers",
      "label": "t:settings.dividers",
      "default": false,
      "visible_if": "{{ block.settings.show_as_accordion == true }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "link_preset",
      "label": "t:settings.link_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "paragraph"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.menu",
      "category": "t:categories.links"
    }
  ]
}
{% endschema %}
