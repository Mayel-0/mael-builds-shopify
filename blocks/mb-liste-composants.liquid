{%- liquid
  # Le projet vient du parent, dans cet ordre :
  # 1. le projet du produit transmis (fiche produit, Groupe produit, Hero en mode produit)
  # 2. le projet transmis directement (Hero en mode projet)
  # 3. le projet de la page en cours (page projet)
  assign projet = blank
  if closest.product != blank
    assign projet = closest.product.metafields.custom.projet.value
  elsif closest.metaobject.projet != blank
    assign projet = closest.metaobject.projet
  elsif metaobject.system.type == 'projet'
    assign projet = metaobject
  endif
  assign lignes = projet.composant.value
-%}

{%- if lignes != blank -%}
  <div
    class="mb-liste-composants{% if block.settings.afficher_separateurs %} mb-liste-composants--separateurs{% endif %}"
    {{ block.shopify_attributes }}
  >
    {%- for ligne in lignes -%}
      {%- render 'mb-composant-ligne', ligne: ligne, composant: ligne.composant.value -%}
    {%- endfor -%}
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>{{ 'mael.editeur.aucun_composant' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:mael.liste_composants.name",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "afficher_separateurs", "label": "t:mael.liste_composants.separateurs", "default": true }
  ],
  "presets": [{ "name": "t:mael.liste_composants.name" }]
}
{% endschema %}
