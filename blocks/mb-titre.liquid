{%- doc -%}
  Bloc « Titre » générique : le seul titre du thème, utilisable partout.

  Il ne devine rien selon la page : toutes ses valeurs (titre, label, badge, lien)
  viennent des réglages. Dans l'éditeur, chaque champ peut être écrit à la main
  ou connecté à une source dynamique (titre du produit, champ d'un projet…).

  @example
  {% content_for 'block', type: 'mb-titre', id: 'titre' %}
{%- enddoc -%}

{%- liquid
  assign titre = block.settings.titre
  assign label = block.settings.label
  assign badge = block.settings.badge

  # Type du produit fourni par le parent (fiche produit, carte, Groupe produit).
  # Le type n'existe pas comme source dynamique : on le lit via closest.product.
  assign type = blank
  if block.settings.afficher_type
    assign type = closest.product.type
  endif
  assign lien = block.settings.lien
  assign balise = block.settings.niveau
-%}

{%- if titre != blank -%}
  <div
    class="mb-titre"
    {{ block.shopify_attributes }}
    style="
      --margin-top: {{ block.settings.margin_top }}px;
      --margin-bottom: {{ block.settings.margin_bottom }}px;
      --margin-left: {{ block.settings.margin_left }}px;
      --margin-right: {{ block.settings.margin_right }}px;
      --style-texte-label: {{ block.settings.style_label }};
      --taille-titre: {{ block.settings.taille }};
    "
  >
    {%- if label != blank or type != blank or badge != blank -%}
      <div class="mb-titre__ligne">
        {%- if label != blank or type != blank -%}
          <p class="mb-titre__label{% if block.settings.trait_label %} mb-titre__label--trait{% endif %}">
            {{- label -}}
            {%- if label != blank and type != blank %} · {% endif -%}
            {{- type -}}
          </p>
        {%- endif -%}
        {%- render 'mb-badge-difficulte', difficulte: badge, prefixe: block.settings.prefixe_badge -%}
      </div>
    {%- endif -%}

    <{{ balise }} class="mb-titre__titre">
      {%- if lien != blank -%}
        {%- comment -%} ref="productTitleLink" : lu par product-card.js pour suivre la variante choisie dans une carte {%- endcomment -%}
        <a class="mb-titre__lien" ref="productTitleLink" href="{{ lien }}">{{ titre }}</a>
      {%- else -%}
        {{- titre -}}
      {%- endif -%}
    </{{ balise }}>
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>{{ 'mael.editeur.titre' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:mael.titre.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "titre",
      "label": "t:settings.title",
      "info": "t:mael.titre.titre_info"
    },
    {
      "type": "url",
      "id": "lien",
      "label": "t:settings.link",
      "info": "t:mael.titre.lien_info"
    },
    { "type": "header", "content": "t:mael.titre.header_ligne" },
    {
      "type": "text",
      "id": "label",
      "label": "t:mael.titre.label",
      "info": "t:mael.titre.label_info"
    },
    {
      "type": "checkbox",
      "id": "afficher_type",
      "label": "t:mael.titre.afficher_type",
      "info": "t:mael.titre.afficher_type_info",
      "default": false
    },
    { "type": "checkbox", "id": "trait_label", "label": "t:mael.titre.trait_label", "default": false },
    {
      "type": "select",
      "id": "style_label",
      "label": "t:mael.titre.style_label",
      "default": "uppercase",
      "options": [
        { "label": "t:options.uppercase", "value": "uppercase" },
        { "label": "t:mael.titre.casse_normale", "value": "none" }
      ]
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:mael.commun.badge",
      "info": "t:mael.titre.badge_info"
    },
    {
      "type": "text",
      "id": "prefixe_badge",
      "label": "t:mael.commun.prefixe_badge",
      "default": "t:mael.defauts.niveau"
    },
    { "type": "header", "content": "t:settings.title" },
    {
      "type": "select",
      "id": "niveau",
      "label": "t:mael.titre.niveau",
      "default": "h2",
      "info": "t:mael.titre.niveau_info",
      "options": [
        { "label": "t:mael.titre.h1", "value": "h1" },
        { "label": "t:mael.titre.h2", "value": "h2" },
        { "label": "t:mael.titre.h3", "value": "h3" },
        { "label": "t:mael.titre.h4", "value": "h4" }
      ]
    },
    {
      "type": "select",
      "id": "taille",
      "label": "t:settings.size",
      "default": "32px",
      "options": [
        { "label": "t:mael.titre.taille_14", "value": "14px" },
        { "label": "t:mael.titre.taille_16", "value": "16px" },
        { "label": "t:mael.titre.taille_20", "value": "20px" },
        { "label": "t:mael.titre.taille_24", "value": "24px" },
        { "label": "t:mael.titre.taille_32", "value": "32px" },
        { "label": "t:mael.titre.taille_40", "value": "40px" }
      ]
    },
    { "type": "header", "content": "t:content.margin" },
    { "type": "range", "id": "margin_top", "label": "t:settings.top", "min": 0, "max": 50, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "t:settings.bottom", "min": 0, "max": 50, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_left", "label": "t:settings.left", "min": 0, "max": 50, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_right", "label": "t:settings.right", "min": 0, "max": 50, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:mael.titre.name",
      "settings": {
        "titre": "t:mael.defauts.titre"
      }
    }
  ]
}
{% endschema %}
