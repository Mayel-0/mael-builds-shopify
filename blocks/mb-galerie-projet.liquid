{%- liquid
  # Le projet vient du parent, dans cet ordre :
  # 1. le projet du produit transmis (fiche produit, Groupe produit, Hero en mode produit)
  # 2. le projet transmis directement (Hero en mode projet)
  # 3. le projet de la page en cours (page projet)
  assign projet = blank
  if closest.product != blank
    assign projet = closest.product.metafields.custom.projet.value
  elsif closest.metaobject.projet != blank
    assign projet = closest.metaobject.projet
  elsif metaobject.system.type == 'projet'
    assign projet = metaobject
  endif
  assign images = projet.galerie.value
-%}

{%- if images != blank -%}
  <div
    class="mb-galerie-projet {{ block.settings.disposition }}"
    style="--gap-galerie: {{ block.settings.espacement }}px; --rayon-galerie: {{ block.settings.arrondi }}px;"
    {{ block.shopify_attributes }}
  >
    {%- comment -%} images est une LISTE : une boucle pour passer chaque image à image_url {%- endcomment -%}
    {%- for image in images -%}
      <figure class="mb-galerie-projet__element">
        {{
          image
          | image_url: width: 1200
          | image_tag:
            alt: image.alt,
            loading: 'lazy',
            widths: '400, 800, 1200',
            sizes: '(min-width: 750px) 33vw, 100vw',
            class: 'mb-galerie-projet__image'
        }}
        {%- if block.settings.afficher_legendes and image.alt != blank -%}
          <figcaption class="mb-galerie-projet__legende">{{ image.alt }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>{{ 'mael.editeur.aucune_image' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:mael.galerie.name",
  "tag": null,
  "presets": [{ "name": "t:mael.galerie.name" }],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:mael.galerie.aide"
    },
    {
      "type": "select",
      "id": "disposition",
      "label": "t:settings.layout",
      "default": "mb-galerie-projet--mosaique",
      "options": [
        { "label": "t:mael.galerie.mosaique", "value": "mb-galerie-projet--mosaique" },
        { "label": "t:mael.galerie.grille", "value": "mb-galerie-projet--grille" }
      ]
    },
    {
      "type": "range",
      "id": "espacement",
      "label": "t:settings.gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "arrondi",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    { "type": "checkbox", "id": "afficher_legendes", "label": "t:mael.galerie.legendes", "default": false }
  ]
}
{% endschema %}
