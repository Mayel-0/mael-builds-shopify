{%- doc -%}
  Groupe qui fournit un produit à tous les blocs placés dedans.

  Le produit vient du réglage « Produit » (choisi à la main ou connecté à une
  source dynamique, ex. le champ « produit » d'un projet). Les blocs enfants le
  lisent avec `closest.product` : titre relié à {{ closest.product.title }}, prix,
  bouton d'ajout au panier… sans savoir d'où vient le produit.

  @example
  {% content_for 'block', type: 'mb-groupe-produit', id: 'groupe-produit' %}
{%- enddoc -%}

<div
  class="mb-groupe-produit {{ block.settings.direction }}"
  style="--gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.produit == blank and request.design_mode -%}
    <p class="mb-groupe-produit__vide">{{ 'mael.editeur.aucun_produit' | t }}</p>
  {%- endif -%}

  {% content_for 'blocks', closest.product: block.settings.produit %}
</div>

{% schema %}
{
  "name": "t:mael.groupe_produit.name",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "product",
      "id": "produit",
      "label": "t:settings.product",
      "info": "t:mael.groupe_produit.produit_info"
    },
    { "type": "header", "content": "t:settings.layout" },
    {
      "type": "select",
      "id": "direction",
      "label": "t:settings.direction",
      "default": "mb-groupe-produit--vertical",
      "options": [
        { "value": "mb-groupe-produit--vertical", "label": "t:options.vertical" },
        { "value": "mb-groupe-produit--horizontal", "label": "t:options.horizontal" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:mael.groupe_produit.gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "t:mael.groupe_produit.name",
      "settings": {
        "produit": "{{ closest.product }}"
      },
      "blocks": [
        {
          "type": "mb-titre",
          "settings": {
            "titre": "{{ closest.product.title }}",
            "lien": "{{ closest.product.url }}",
            "niveau": "h3",
            "taille": "20px"
          }
        },
        { "type": "price" }
      ]
    }
  ]
}
{% endschema %}
