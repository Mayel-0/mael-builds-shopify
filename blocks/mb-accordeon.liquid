{%- comment -%} On capture les blocs enfants pour les donner au snippet existant {%- endcomment -%}
{%- capture contenu -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}

<div class="mb-accordeon" {{ block.shopify_attributes }}>
  {% render 'mb-details',
    titre: block.settings.titre,
    contenu: contenu,
    ouvert: block.settings.ouvert,
    bordure: block.settings.afficher_bordure,
    niveau: block.settings.niveau
  %}
</div>

{% schema %}
{
  "name": "t:mael.accordeon.name",
  "tag": null,
  "blocks": [{ "type": "mb-liste-pieces" }, { "type": "mb-liste-composants" }, { "type": "@theme" }],
  "settings": [
    { "type": "text", "id": "titre", "label": "t:settings.title", "default": "t:mael.defauts.informations" },
    { "type": "checkbox", "id": "ouvert", "label": "t:settings.open_by_default", "default": false },
    { "type": "checkbox", "id": "afficher_bordure", "label": "t:mael.commun.bordure_bas", "default": true },
    {
      "type": "select",
      "id": "niveau",
      "label": "t:mael.titre.niveau",
      "info": "t:mael.defauts.niveau_info",
      "default": "h2",
      "options": [
        { "label": "t:mael.titre.h2", "value": "h2" },
        { "label": "t:mael.titre.h3", "value": "h3" },
        { "label": "t:mael.titre.h4", "value": "h4" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:mael.accordeon.preset_vide"
    },
    {
      "name": "t:mael.accordeon.preset_fiche",
      "settings": { "titre": "t:mael.defauts.fiche_technique" },
      "blocks": [{ "type": "mb-liste-pieces" }]
    },
    {
      "name": "t:mael.accordeon.preset_materiel",
      "settings": { "titre": "t:mael.defauts.materiel" },
      "blocks": [{ "type": "mb-liste-composants" }]
    }
  ]
}
{% endschema %}
