<div class="mb-garanties" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:mael.garanties.name",
  "blocks": [{ "type": "mb-garantie" }],
  "presets": [
    {
      "name": "t:mael.garanties.name",
      "blocks": [
        {
          "type": "mb-garantie",
          "settings": { "titre": "t:mael.defauts.garantie_telechargement", "texte": "t:mael.defauts.garantie_telechargement_texte" }
        },
        { "type": "mb-garantie", "settings": { "titre": "t:mael.defauts.garantie_paiement", "texte": "t:mael.defauts.garantie_paiement_texte" } },
        {
          "type": "mb-garantie",
          "settings": { "titre": "t:mael.defauts.garantie_projets", "texte": "t:mael.defauts.garantie_projets_texte" }
        }
      ]
    }
  ]
}
{% endschema %}
